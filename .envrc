#!/usr/bin/env bash

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

watch_file meta/devenv/default.nix
watch_file meta/devenv/packages.nix
watch_file meta/devenv/scripts.nix
watch_file flake.nix
watch_file flake.lock
watch_file .tack/pins.toml
watch_file .tack/pins.lock.json

if ! use flake . --impure; then
  echo "devenv could not be built. The devenv environment was not loaded. Make the necessary changes to meta/devenv/ and hit enter to try again." >&2
fi

