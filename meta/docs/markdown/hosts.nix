{
  lib,
  config,
  options,
  ...
}: let
  graphLib = config.flake.lib.graph;
  shared = config.internal.docs.markdown.shared;
  trees = config.internal.docs.trees;

  renderHostDoc = {
    graph,
    hostNode,
  }: let
    name = hostNode.name;
    props = hostNode.properties;
    desc = props.description or "";
    systemArch = props.system or "x86_64-linux";
    stateVer = props.stateVersion or "25.11";
    activeContracts = props.activeContracts or [];
    features = props.featureList or [];
    subModules = props.subModulesList or [];
    packages = props.packages or [];
    devShells = props.devShells or [];
    libExports = props.lib or [];

    hCfg = config.flake.nixosConfigurations.${name} or null;
    diskTree =
      if hCfg != null
      then trees.generateDiskTree hCfg
      else "No Disko configuration defined.";
    persistTree =
      if hCfg != null
      then trees.generatePersistTree hCfg
      else "";

    hostNeighborhood = graphLib.getNeighborhood {
      inherit graph;
      nodeId = hostNode.id;
      depth = 2;
    };
    hostMermaid = graphLib.renderMermaid {
      graph = hostNeighborhood;
      layout = "LR";
      linkFn = shared.makeDocLinkFn {relPrefix = "..";};
    };

    contractRow = c: "| [`${c.contract}`](../contracts/${c.contract}.md) | ${c.contractDescription} | [`${c.implementation}`](../implementations/${c.implementation}.md) | ${c.implementationDescription} |";

    featureRow = f: "| [`${f.name}`](../features/${f.name}.md) | ${f.description} | ${f.outputs} |";

    subModuleRow = sub: "| [`${sub.name}`](../modules/${sub.name}.md) | Host configuration submodule | [More →](../modules/${sub.name}.md) |";

    renderSubDetail = sub: ''
      <details>
      <summary><code>${sub.name}</code></summary>

      ```nix
      ${sub.code}
      ```

      </details>
    '';
  in ''
    # Host: `${name}`

    ${desc}

    [← Back to Hosts Documentation](../HOSTS.md) | [← Back to Main README](../../README.md)

    ## Metadata

    - **Target Host**: `${name}`
    - **Description**: ${desc}
    - **Architecture**: `${systemArch}`
    - **State Version**: `${stateVer}`
    - **Definition File**: [`${props.file}`](../../${props.file})

    ## Host Architecture Diagram

    ${hostMermaid}

    ## Active Contracts

    The following contracts are materialized on `${name}` through its active implementation providers:

    ${
      if activeContracts != []
      then
        graphLib.renderTable {
          headers = ["Contract" "Description" "Implementation" "Description"];
          columns = [
            (c: "[`${c.contract}`](../contracts/${c.contract}.md)")
            (c: c.contractDescription or "")
            (c: "[`${c.implementation}`](../implementations/${c.implementation}.md)")
            (c: c.implementationDescription or "")
          ];
          rows = activeContracts;
        }
      else "*No active contracts defined.*"
    }

    ## Enabled Features

    The following system and desktop features are imported by `${name}`:

    ${
      if features != []
      then
        graphLib.renderTable {
          headers = ["Feature" "Description" "Outputs"];
          columns = [
            (f: "[`${f.name}`](../features/${f.name}.md)")
            (f: f.description or "")
            (f: f.outputs or "")
          ];
          rows = features;
        }
      else "*No features enabled.*"
    }

    ## Storage & Filesystem Layout

    Evaluated partition table and Btrfs subvolumes generated by Disko:

    ```text
    ${diskTree}
    ```

    Evaluated persisted directories and state preserved across boots by Impermanence:

    ```text
    ${persistTree}
    ```

    ## Host Submodules

    Host-specific configuration submodules partitioning hardware, disks, and local system services:

    ${
      if subModules != []
      then
        graphLib.renderTable {
          headers = ["Submodule Attribute" "Description" "Docs"];
          columns = [
            (sub: "[`${sub.name}`](../modules/${sub.name}.md)")
            (_: "Host configuration submodule")
            (sub: "[More →](../modules/${sub.name}.md)")
          ];
          rows = subModules;
        }
      else "*No host submodules declared.*"
    }

    ${lib.concatMapStringsSep "\n\n" renderSubDetail subModules}

    ${
      if packages != [] || devShells != [] || libExports != []
      then ''
        ## Outputs

        ### Executable Packages

        ${shared.renderPkgTable {inherit packages;}}

        ### Development Shells

        ${shared.renderShellTable {inherit devShells;}}

        ### Library Helpers

        ${shared.renderLibTable {
          inherit libExports;
          ns = name;
        }}
      ''
      else ""
    }

    ## Installation

    ### Track 1: Remote Automated Provisioning via `nixos-anywhere`

    ```bash
    nix run github:nix-community/nixos-anywhere -- \
      --flake .#${name} \
      --copy-secret /path/to/key.txt /persist/var/lib/sops-nix/key.txt \
      root@<TARGET-IP>
    ```

    ### Track 2: Local Installation from Live ISO

    ```bash
    nix --extra-experimental-features 'nix-command flakes' run github:nix-community/disko -- \
      --mode zap_create_mount \
      --flake .#${name}

    nixos-install --flake .#${name} --no-root-passwd
    ```

    ### Track 3: Routine Maintenance & Activation

    ```bash
    # Local rebuild
    sudo nixos-rebuild switch --flake .#${name}

    # Remote rebuild over SSH
    nixos-rebuild switch --flake .#${name} --target-host root@<TARGET-IP>
    ```
  '';

  renderHostsIndex = {graph}: let
    hosts = builtins.filter (n: n.kind == "host") (builtins.attrValues graph.nodes);
    hostsCatalog = graphLib.renderTable {
      headers = ["Host" "Description" "System" "Docs"];
      columns = [
        (h: "[`${h.name}`](hosts/${h.name}.md)")
        (h: h.properties.description or "")
        (h: "`${h.properties.system or "x86_64-linux"}`")
        (h: "[More →](hosts/${h.name}.md)")
      ];
      rows = hosts;
    };
  in ''
    # Hosts Documentation

    Master host target registry declared via `options.host` in [`primitives/host/default.nix`](../primitives/host/default.nix).

    [← Back to Main README](../README.md)

    ## Primitive Specification

    ${options.host.description}

    ### Option Schema (`options.host.<name>`)

    - `description` (string, required): Formal description of the target machine and role.
    - `system` (string, default: `"x86_64-linux"`): Target platform architecture.
    - `modules` (listOf deferredModule, default: `[]`): Top-level NixOS modules (features, implementations).
    - `subModules` (attrsOf deferredModule, default: `{}`): Host configuration submodules (hardware, disk, local services).
    - `packages` (raw, default: `{}`): Host-specific executable packages or generator function.
    - `devShells` (raw, default: `{}`): Host-specific recovery/administrative shells or generator function.
    - `lib` (attrsOf raw, default: `{}`): Host-specific library helpers exported on `flake.lib.<host>`.

    ### Declaration Example (`host.<name>`)

    ```nix
    host.example-machine = {
      description = "Headless edge compute server.";
      system = "x86_64-linux";
      modules = [
        self.nixosModules.caddy
      ];
      subModules = {
        example-hardware = { ... }: { ... };
      };
    };
    ```

    ## Target Hosts Catalog

    ${hostsCatalog}
  '';
in {
  internal.docs.markdown.hosts = {
    inherit
      renderHostDoc
      renderHostsIndex
      ;
  };
}
