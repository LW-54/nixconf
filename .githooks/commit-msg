#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?missing commit message file}"
subject="$(grep -vE '^\s*(#|$)' "$msg_file" | head -n 1 || true)"

if [[ -z "$subject" ]]; then
  echo "ERROR: Commit message subject cannot be empty." >&2
  exit 1
fi

# Allow standard git merge commits
merge_re='^Merge '
if [[ "$subject" =~ $merge_re ]]; then
  exit 0
fi

# Explicitly reject parenthetical scopes like type(scope): ...
scope_re='^[a-zA-Z0-9_-]+\([^)]*\):'
if [[ "$subject" =~ $scope_re ]]; then
  echo "ERROR: Commit message must not use parenthetical scopes like 'type(scope): ...'." >&2
  echo "  Got:      $subject" >&2
  echo "  Expected: <type>: <description> (e.g. 'feat: ...', 'fix: ...')" >&2
  exit 1
fi

# Enforce <type>: <description>
type_re='^(feat|fix|refactor|docs|chore|revert|test|perf|ci): .+'
if [[ ! "$subject" =~ $type_re ]]; then
  echo "ERROR: Commit message must match '<type>: <description>'." >&2
  echo "  Allowed types: feat, fix, refactor, docs, chore, revert, test, perf, ci" >&2
  echo "  Got:           $subject" >&2
  exit 1
fi
