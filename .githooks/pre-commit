#!/usr/bin/env bash
set -euo pipefail

if ! command -v nix >/dev/null 2>&1; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Collect staged files (Added, Copied, Modified, Renamed)
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
  exit 0
fi

mapfile -t STAGED_NIX < <(printf '%s\n' "${STAGED_FILES[@]}" | grep '\.nix$' || true)

# 1. Fast staged-only Nix formatting (direct alejandra avoids a 2.5s Nix flake eval)
if [ "${#STAGED_NIX[@]}" -gt 0 ]; then
  ALEJANDRA=""
  if command -v alejandra >/dev/null 2>&1; then
    ALEJANDRA="$(command -v alejandra)"
  elif [ -x "$REPO_ROOT/.devenv/profile/bin/alejandra" ]; then
    ALEJANDRA="$REPO_ROOT/.devenv/profile/bin/alejandra"
  fi

  echo "==> [pre-commit] Formatting ${#STAGED_NIX[@]} staged Nix file(s)..."
  if [ -n "$ALEJANDRA" ]; then
    "$ALEJANDRA" --quiet "${STAGED_NIX[@]}"
  else
    nix fmt "${STAGED_NIX[@]}"
  fi

  if ! git diff --quiet -- "${STAGED_NIX[@]}"; then
    git add -- "${STAGED_NIX[@]}"
    echo "==> [pre-commit] Formatted Nix files staged."
  fi
fi

# Determine which fast validation & sync targets are relevant to this commit
NEEDS_NIX_SYNC=0
NEEDS_DOCS_ONLY=0
NEEDS_CI_LINT=0
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    meta/ci/*|.github/workflows/*)
      NEEDS_NIX_SYNC=1
      NEEDS_CI_LINT=1
      ;;
    *.nix|.tack/*|flake.lock|meta/*|primitives/*|modules/*)
      NEEDS_NIX_SYNC=1
      ;;
    README.md|docs/*)
      NEEDS_DOCS_ONLY=1
      ;;
  esac
done

if [ "$NEEDS_NIX_SYNC" -eq 0 ] && [ "$NEEDS_DOCS_ONLY" -eq 0 ]; then
  echo "==> [pre-commit] No Nix/docs/CI files staged; skipping Nix evaluation."
  exit 0
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) SYS="x86_64-linux" ;;
  Linux-aarch64) SYS="aarch64-linux" ;;
  Darwin-arm64) SYS="aarch64-darwin" ;;
  Darwin-x86_64) SYS="x86_64-darwin" ;;
  *) SYS="x86_64-linux" ;;
esac

# 2. Single shared Nix evaluation for docs + CI sync + fast static checks (schemas + host evals)
#    All targets share one Nix evaluator process, one memoized nixpkgs, and one host eval.
if [ "$NEEDS_NIX_SYNC" -eq 1 ]; then
  echo "==> [pre-commit] Evaluating docs, CI workflows, schemas, and host eval checks in one pass..."
  TARGETS=(
    ".#packages.${SYS}.docs"
    ".#packages.${SYS}.ci"
    ".#checks.${SYS}.schemas"
    ".#checks.${SYS}.eval-astrolabe"
    ".#checks.${SYS}.eval-x240"
  )
else
  echo "==> [pre-commit] Synchronizing docs and CI workflows in one pass..."
  TARGETS=(
    ".#packages.${SYS}.docs"
    ".#packages.${SYS}.ci"
  )
fi

if [ "$NEEDS_CI_LINT" -eq 1 ]; then
  TARGETS+=(".#legacyPackages.${SYS}.ciActionlint")
fi

OUT_PATHS="$(nix build --no-link --print-out-paths "${TARGETS[@]}")"
mapfile -t BUILT <<< "$OUT_PATHS"
DOCS_OUT="${BUILT[0]}"
CI_OUT="${BUILT[1]}"

# 3. Synchronize docs & CI directly from already-built store paths (~30ms, zero extra Nix evals)
"$DOCS_OUT/bin/nixconf-docs" --write
if ! git diff --quiet README.md docs/ 2>/dev/null || [ -n "$(git ls-files --others --exclude-standard docs/)" ]; then
  git add README.md docs/
  echo "==> [pre-commit] Documentation suite updated and staged."
fi

"$CI_OUT/bin/nixconf-ci" --write
if [ "$NEEDS_CI_LINT" -eq 1 ]; then
  ACTIONLINT_OUT="${BUILT[$((${#BUILT[@]} - 1))]}"
  "$ACTIONLINT_OUT/bin/actionlint" .github/workflows/*.yml
fi
if ! git diff --quiet .github/workflows/ 2>/dev/null || [ -n "$(git ls-files --others --exclude-standard .github/workflows/)" ]; then
  git add .github/workflows/
  echo "==> [pre-commit] GitHub Actions CI workflows updated and staged."
fi

echo "==> [pre-commit] All fast pre-commit checks passed! (Run 'just check' for full inspect builds)"
